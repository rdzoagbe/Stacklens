rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Founder access: the founder's UID, their verified email, or the
    // is_founder flag on their user doc. The UID allowlist exists because the
    // founder's Google sign-in was created without an email claim (OAuth
    // reconfiguration mishap), so the email check alone cannot match their
    // token. Kept in sync with FOUNDER_EMAILS in src/lib/constants.js.
    function isFounderEmail() {
      return isSignedIn() && request.auth.token.email == 'rolanddzoagbe@gmail.com';
    }
    function isFounderUid() {
      return isSignedIn() && request.auth.uid == 'bxIYrZ76z1QKo5ZMpGvEG8GGbNM2';
    }
    function isFounder() {
      return isFounderEmail() || isFounderUid() ||
        (isSignedIn()
         && exists(/databases/$(database)/documents/users/$(request.auth.uid))
         && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('is_founder', false) == true);
    }

    // Returns true if the incoming write does NOT touch any protected field.
    // Protected fields can only be set by the Stripe webhook or founderAdmin Cloud Function
    // (both use Admin SDK which bypasses rules).
    // EXCEPTION: users may self-start a trial — set plan='trial' + trial_started_at.
    // Handles both create (resource == null) and update cases.
    function protectedFieldsSafe() {
      let protectedFields = ['plan', 'subscription_plan', 'stripe_customer_id',
                             'stripe_subscription_id', 'subscription_status',
                             'subscription_current_period_end', 'is_admin',
                             'is_founder', 'role'];
      // Check if user is just starting their trial — that's allowed once.
      // For updates: only permit if the existing doc has no trial_started_at yet
      // and the current plan is 'free', preventing trial replay attacks.
      let isNewDoc = resource == null;
      let isTrialStart = request.resource.data.keys().hasAny(['plan', 'trial_started_at'])
                         && request.resource.data.get('plan', '') == 'trial'
                         && !request.resource.data.keys().hasAny(
                              ['subscription_plan', 'stripe_customer_id',
                               'stripe_subscription_id', 'subscription_status',
                               'subscription_current_period_end', 'is_admin',
                               'is_founder', 'role'])
                         && (isNewDoc || (
                               !resource.data.keys().hasAny(['trial_started_at'])
                               && resource.data.get('plan', 'free') == 'free'
                            ));
      // Reject if the incoming data has any protected field at all,
      // UNLESS it's 'plan' == 'free' (new user default allowed)
      // OR plan='trial' + trial_started_at (self-start trial allowed)
      return !request.resource.data.keys().hasAny(protectedFields)
             || isTrialStart
             || (request.resource.data.keys().hasAny(['plan'])
                 && request.resource.data.plan == 'free'
                 && !request.resource.data.keys().hasAny(
                      ['subscription_plan', 'stripe_customer_id',
                       'stripe_subscription_id', 'subscription_status',
                       'subscription_current_period_end', 'is_admin',
                       'is_founder', 'role']));
    }

    // Once a trial has been started, the owner can NEVER change or clear
    // trial_started_at. This defeats the trial-replay attack: without it, a
    // user could write plan='free' + delete trial_started_at, then re-trigger
    // the trial-start path to reset their 7-day trial indefinitely. Founders
    // (Admin SDK / founderWriteSafe path) are exempt and may still reset trials.
    function trialStampImmutable() {
      return resource == null
          || !resource.data.keys().hasAny(['trial_started_at'])
          || request.resource.data.get('trial_started_at', null) == resource.data.trial_started_at;
    }

    // Founders may update plan, trial, and profile fields on any user doc.
    function founderWriteSafe() {
      let allowed = ['plan', 'trial_started_at', 'displayName', 'email', 'photoURL', 'updatedAt'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // /users/{uid}
    match /users/{uid} {
      allow get: if isOwner(uid) || isFounder();
      allow list: if isFounder();
      // Create only allowed if new doc has no protected fields (or plan='free')
      allow create: if isOwner(uid) && protectedFieldsSafe();
      // Update: owner with field restrictions (and trial stamp immutable),
      // OR founder can update plan/trial fields
      allow update: if (isOwner(uid) && protectedFieldsSafe() && trialStampImmutable())
                    || (isFounder() && founderWriteSafe());
      allow delete: if false;
    }

    // /userdata/{uid}
    match /userdata/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }
    // /userdata/{uid}/chunks/** — size-capped slices of the large arrays
    // (employees, access, audit_log); rules don't cascade to subcollections,
    // so the owner grant must be repeated here.
    match /userdata/{uid}/{document=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    // /rate_limits/{uid}
    match /rate_limits/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // /consent_logs/{logId} — CNIL cookie consent audit trail
    // Anyone (even anonymous visitors) can CREATE a consent record.
    // Nobody can READ, UPDATE, or DELETE from the client.
    // Rule enforces strict schema to prevent abuse (no arbitrary fields, size caps).
    match /consent_logs/{logId} {
      allow read: if false;
      allow update, delete: if false;
      allow create: if
        request.resource.data.choice in ['accepted', 'rejected'] &&
        request.resource.data.version is string &&
        request.resource.data.version.size() < 32 &&
        request.resource.data.userAgent is string &&
        request.resource.data.userAgent.size() < 300 &&
        request.resource.data.language is string &&
        request.resource.data.language.size() < 16 &&
        request.resource.data.timestamp == request.time;
    }

    // /legal_acceptances/{logId} — GDPR/LCEN legal agreement acceptance audit trail
    // Authenticated users can CREATE their own acceptance record.
    // Nobody can READ, UPDATE, or DELETE from the client.
    match /legal_acceptances/{logId} {
      allow read: if false;
      allow update, delete: if false;
      allow create: if
        request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.documents is list &&
        request.resource.data.accepted_at == request.time;
    }

    // /reports/{token} — shareable read-only snapshots
    // Anyone with the token can read, but only before the report has expired.
    // Only the authenticated owner can create/delete.
    match /reports/{token} {
      allow read: if resource.data.expires_at is int
                  && resource.data.expires_at > request.time.toMillis();
      allow create: if request.auth != null
                    && request.resource.data.owner_uid == request.auth.uid
                    && request.resource.data.expires_at is int
                    && request.resource.data.expires_at > request.time.toMillis();
      allow delete: if request.auth != null
                    && resource.data.owner_uid == request.auth.uid;
      allow update: if false;
    }

    // Integration credentials (Zoom S2S client secret, and future vendors).
    // Server-only: written and read exclusively by the zoomsync function via
    // the Admin SDK. The default deny below already covers this, but the rule
    // is written out so the intent survives future edits — a client must
    // never be able to read a stored vendor secret back.
    match /integration_credentials/{uid} {
      allow read, write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
