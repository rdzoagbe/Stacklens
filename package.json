{
  "name": "accessguard-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "deploy": "npm run build && firebase deploy --only hosting",
    "prepare": "husky",
    "test:rules": "firebase emulators:exec --only firestore --project stacklens-rules-test \"vitest run --config vitest.rules.config.js\"",
    "test:all": "npm test && npm run test:rules"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.30.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@sentry/react": "^10.73.0",
    "@tanstack/react-query": "^5.108.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.18.0",
    "framer-motion": "^13.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.77.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --quiet"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-security": "^4.2.1",
    "fake-indexeddb": "^6.2.8",
    "firebase-tools": "^15.37.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.6.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
